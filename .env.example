# ═══════════════════════════════════════════════════
# VTX BOT — Configuration
# ═══════════════════════════════════════════════════
# Seuls DISCORD_TOKEN et CLIENT_ID sont obligatoires.
# Tout le reste (salons, rôles, seuils, nom du label) se configure
# PAR SERVEUR avec la commande /setup — le bot est multi-serveur.

# 1. Va sur https://discord.com/developers/applications
# 2. Crée une application > Bot > Copie le token
DISCORD_TOKEN=ton_token_ici

# 3. Clique sur "OAuth2" > copie le Client ID
CLIENT_ID=ton_client_id_ici

# ─── OPTIONNEL ──────────────────────────────────────

# Chemin du fichier SQLite (utile pour un volume persistant Railway/Docker)
# DB_PATH=/data/veltrix.db

# Déploiement des commandes limité à UN serveur (dev). Vide = déploiement global.
# GUILD_ID=

# ─── LEGACY (rétro-compatibilité mono-serveur) ─────
# Ces valeurs ne sont utilisées QUE pour le serveur GUILD_ID ci-dessus,
# et uniquement si /setup n'a pas encore été lancé sur ce serveur.
# STAFF_CHANNEL_ID=
# AR_ROLE_ID=
# STAFF_ROLE_ID=
# REVIEW_ROLE_ID=
# RELEASE_CATEGORY_ID=
# COLLAB_CHANNEL_ID=
# COLLAB_CATEGORY_ID=
# SCORE_THRESHOLD=5
# LABEL_NAME=VELTRIX RECORDS
